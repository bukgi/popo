.window-root {
    flex-grow: 1;
    padding: 12px;
}

.header-box {
    padding: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    border-radius: 6px;
    background-color: rgb(38, 42, 48);
}

.header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 245, 255);
    margin-bottom: 4px;
}

.header-subtitle {
    font-size: 11px;
    color: rgb(175, 185, 200);
    white-space: normal;
}

.section-card {
    padding: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgb(58, 58, 58);
    border-radius: 6px;
    background-color: rgb(44, 44, 44);
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(225, 230, 240);
    margin-bottom: 8px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.grow-field {
    flex-grow: 1;
    margin-right: 6px;
}

.action-button {
    height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    -unity-font-style: bold;
}

.primary-button {
    height: 32px;
    margin-top: 6px;
    margin-bottom: 4px;
    background-color: rgb(46, 118, 196);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-radius: 4px;
}

.secondary-button {
    height: 28px;
    margin-top: 4px;
    background-color: rgb(58, 128, 82);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-radius: 4px;
}

.preset-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.preset-chip {
    margin-right: 4px;
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    height: 22px;
    font-size: 11px;
}

.status-box {
    padding: 8px;
    border-width: 1px;
    border-color: rgb(65, 75, 90);
    border-radius: 4px;
    background-color: rgb(32, 35, 40);
    margin-top: 4px;
}

.status-label {
    font-size: 11px;
    color: rgb(200, 215, 235);
    white-space: normal;
}

.credit-label {
    font-size: 11px;
    color: rgb(245, 208, 115);
    white-space: normal;
    margin-top: 4px;
}

